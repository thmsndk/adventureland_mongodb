# Community prod — copy to repo root as .env
COMMUNITY_BASE_URL=https://play.adventureland.community
COMMUNITY_GS_PUBLIC=gs.adventureland.community
COMMUNITY_GS_PORT=443
COMMUNITY_HTTPS=1
COMMUNITY_HTTP_PORT=8090
COMMUNITY_GS_PORT_PUBLISH=7192
COMMUNITY_PTR_PORT_PUBLISH=7193
MONGO_URI=mongodb://mongo:27017/adventureland?replicaSet=rs0
MONGO_DB=adventureland
# Replace before public deploy (or edit secrets volume after first boot):
# COMMUNITY_SERVER_KEYWORD=
# COMMUNITY_SDK_PASSWORD=
# COMMUNITY_ACCESS_MASTER=
# COMMUNITY_BOT_MASTER=
# COMMUNITY_SERVER_MASTER=
