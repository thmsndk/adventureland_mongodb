# Optional overrides for Mongonaut (docker/compose.mongonaut.yml)
# Copy to repo root as .env if you want custom values (Compose loads .env automatically).

# Host port for Mongonaut UI (dev 8081; community stack sets 18081)
MONGO_UI_PORT=8081
# Dev default: passwordless (NONE). UI is bound to 127.0.0.1 only.
MONGO_UI_AUTH_MODE=NONE
# Set true on community/prod-ish stacks to browse without edits
MONGO_UI_READONLY=false
