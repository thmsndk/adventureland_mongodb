# Optional overrides for Mongonaut (docker/compose.mongonaut.yml)
# Copy to repo root as .env if you want custom values (Compose loads .env automatically).

# Host port for Mongonaut UI (dev 8081; community stack sets 18081)
MONGO_UI_PORT=8081
# Dev default: passwordless (NONE). UI is bound to 127.0.0.1 only.
MONGO_UI_AUTH_MODE=NONE
# Set true on community/prod-ish stacks to browse without edits
MONGO_UI_READONLY=false

# Mailpit (docker-compose.dev.yml): catch-all SMTP — UI http://localhost:8025
# Dev templates default email_provider=smtp, keys.smtp.host=mailpit (seeded on first boot).
# MAILPIT_UI_PORT=8025
# MAILPIT_SMTP_PORT=1025
#
# Private VPS outbound mail (optional — SES API or SMTP relay on port 587):
# EMAIL_PROVIDER=ses
# MAIL_FROM=noreply@yourdomain.com
# MAIL_REPLY_TO=you@yourdomain.com
# AMAZON_SES_USER=
# AMAZON_SES_KEY=
# AMAZON_SES_REGION=eu-west-1
# Or SMTP relay instead of SES:
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# Set EMAIL_PROVIDER=none to disable outbound mail.

# Optional Traefik edge (docker compose -f docker/compose.traefik.yml up -d)
# Prereqs: bash docker/traefik/gen-mkcert.sh + hosts (see docker/traefik/README.md)
#
# Prefer the .traefik.yml overlay (sets env + labels + mongo hostnames):
#   docker compose -f docker-compose.dev.yml -f docker-compose.dev.traefik.yml up --force-recreate
#   docker compose -f docker-compose.community.dev.yml -f docker-compose.community.dev.traefik.yml up --force-recreate
#
# Direct host ports need no .env — templates default localhost:7192 / :17192 / :17193
