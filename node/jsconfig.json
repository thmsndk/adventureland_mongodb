{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"target": "ES2020",
		"lib": ["ES2020"],
		"module": "CommonJS",
		"moduleResolution": "node",
		"maxNodeModuleJsDepth": 0,
		"skipLibCheck": true
	},
	"include": [
		"**/*.js",
		"../types/shared/**/*.d.ts",
		"../types/server/**/*.d.ts"
	],
	"exclude": [
		"**/node_modules/**"
	]
}
